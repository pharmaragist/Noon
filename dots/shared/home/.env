# Constants
export SHELL_PATH="~/.config/noon"

# QT
export QT_AUTO_SCREEN_SCALE_FACTOR=1
export QT_QUICK_CONTROLS_STYLE=Basic
export QT_QPA_PLATFORM=wayland
export QT_QPA_PLATFORMTHEME=kde
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1

# Quickshell
# export QSG_RHI_BACKEND=vulkan

# XCursor
export XCURSOR_THEME=MacOS-Tahoe-Cursor
export XCURSOR_SIZE=24

# GTK
export GTK_CSD=0

# Applications
export TERMINAL=kitty
export BROWSER=firefox
export EDITOR=zed
export FILE_MANAGER=dolphin

# Flags
export CHROMIUM_FLAGS="--disable-features=Vulkan --use-gl=angle --use-angle=gles --ignore-gpu-blocklist"
export PROTON_USE_WAYLAND=1
export PROTON_DXVK_LOWLATENCY=1

# Terminal
export SHELL=/bin/fish
export TERMINAL_OPACITY=1
export USE_POKEMON=false

# User
