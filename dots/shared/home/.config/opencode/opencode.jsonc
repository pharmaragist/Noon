{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [],
  "mcp": {
    "servers": {
      "github": {
        "command": [
          "npx",
          "-y",
          "@modelcontextprotocol/server-github"
        ],
        "disabled": false,
        "type": "local"
      }
    }
  },
