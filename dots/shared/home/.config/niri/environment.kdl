environment {
    __NV_PRIME_RENDER_OFFLOAD "0"
    __GLX_VENDOR_LIBRARY_NAME "mesa"
    MOZ_ENABLE_WAYLAND "1"
    LIBVA_DRIVER_NAME "iHD"
    NVD_BACKEND "direct"
    AQ_FORCE_LINEAR_BLIT "1"
    UV_WORKING_DIR "/home/pharmaracist/.local/state/noon/"

    XDG_MENU_PREFIX "plasma-"
    PLASMA_USE_QT_SCALING "1"

    ELECTRON_OZONE_PLATFORM_HINT "wayland"
    QT_QPA_PLATFORM "wayland;xcb"
    QT_WAYLAND_DISABLE_WINDOWDECORATION "1"
    QT_QPA_PLATFORMTHEME "kde"

    FILE_MANAGER "dolphin"
    EDITOR "zed"
    SHELL_VENV "/home/pharmaracist/.local/state/noon"
    SHELL_EXECUTABLE "qs -c /home/pharmaracist/.config/noon"
    SHELL_PATH "/home/pharmaracist/.config/noon"
    SHELL_CONFIG_PATH "/home/pharmaracist/.noon"
    SHELL_CONFIG_FILE "/home/pharmaracist/.noon/options.json"
    TERMINAL "kitty"
    BROWSER "firefox"
    XDG_CURRENT_DESKTOP "niri"
    GTK_CSD "0"
}
