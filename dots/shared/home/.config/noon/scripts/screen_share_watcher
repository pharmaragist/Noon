#!/usr/bin/env bash
RESULT_FILE="/var/tmp/cast-picker-result"
WINDOW_DATA="/var/tmp/cast-window-data"

>"$RESULT_FILE"
echo "$XDPH_WINDOW_SHARING_LIST" >"$WINDOW_DATA"

# ponytail: npc over its socket (~20ms) instead of noon/qs (~100ms+).
# dirname-based (portal env has no PATH guarantees), noon as fallback.
NPC=($(dirname "$0")/npc call); [[ -x "${NPC[0]}" ]] || NPC=(noon ipc call)
"${NPC[@]}" sidebar reveal Cast 2>/dev/null

for _ in $(seq 1 150); do
  [[ -s "$RESULT_FILE" ]] && break
  sleep 0.1
done
RESULT=$(<"$RESULT_FILE")
rm -f "$WINDOW_DATA" 2>/dev/null

[[ -z "$RESULT" || "$RESULT" == "__cancel__" ]] && exit 1

echo "$RESULT"
