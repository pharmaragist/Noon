{
  "$schema": "https://opencode.ai/theme.json",
  "defs": {
    "primary": "{{colors.primary.default.hex}}",
    "primary_fixed": "{{colors.primary_fixed.default.hex}}",
    "primary_fixed_dim": "{{colors.primary_fixed_dim.default.hex}}",
    "primary_container": "{{colors.primary_container.default.hex}}",
    "secondary": "{{colors.secondary.default.hex}}",
    "secondary_fixed": "{{colors.secondary_fixed.default.hex}}",
    "secondary_fixed_dim": "{{colors.secondary_fixed_dim.default.hex}}",
    "secondary_container": "{{colors.secondary_container.default.hex}}",
    "tertiary": "{{colors.tertiary.default.hex}}",
    "tertiary_fixed": "{{colors.tertiary_fixed.default.hex}}",
    "tertiary_fixed_dim": "{{colors.tertiary_fixed_dim.default.hex}}",
    "tertiary_container": "{{colors.tertiary_container.default.hex}}",
    "error": "{{colors.error.default.hex}}",
    "error_container": "{{colors.error_container.default.hex}}",
    "surface_container_low": "{{colors.surface_container_low.default.hex}}",
    "surface_container": "{{colors.surface_container.default.hex}}",
    "surface_container_high": "{{colors.surface_container_high.default.hex}}",
    "surface_container_highest": "{{colors.surface_container_highest.default.hex}}",
    "on_surface": "{{colors.on_surface.default.hex}}",
    "on_surface_variant": "{{colors.on_surface_variant.default.hex}}",
    "outline_variant": "{{colors.outline_variant.default.hex}}",
    "transparent": "transparent"
  },
  "theme": {
    "primary": {
      "dark": "primary",
      "light": "primary"
    },
    "secondary": {
      "dark": "secondary",
      "light": "secondary"
    },
    "accent": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "error": {
      "dark": "error",
      "light": "error"
    },
    "warning": {
      "dark": "tertiary_fixed_dim",
      "light": "tertiary_fixed_dim"
    },
    "success": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "info": {
      "dark": "primary",
      "light": "primary"
    },
    "text": {
      "dark": "on_surface",
      "light": "on_surface"
    },
    "textMuted": {
      "dark": "on_surface_variant",
      "light": "on_surface_variant"
    },
    "background": {
      "dark": "transparent",
      "light": "transparent"
    },
    "backgroundPanel": {
      "dark": "surface_container",
      "light": "surface_container"
    },
    "backgroundElement": {
      "dark": "surface_container_high",
      "light": "surface_container_high"
    },
    "border": {
      "dark": "transparent",
      "light": "transparent"
    },
    "borderActive": {
      "dark": "primary",
      "light": "primary"
    },
    "borderSubtle": {
      "dark": "transparent",
      "light": "transparent"
    },
    "diffAdded": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "diffRemoved": {
      "dark": "error",
      "light": "error"
    },
    "diffContext": {
      "dark": "on_surface_variant",
      "light": "on_surface_variant"
    },
    "diffHunkHeader": {
      "dark": "secondary_container",
      "light": "secondary_container"
    },
    "diffHighlightAdded": {
      "dark": "tertiary_fixed",
      "light": "tertiary_fixed"
    },
    "diffHighlightRemoved": {
      "dark": "error",
      "light": "error"
    },
    "diffAddedBg": {
      "dark": "tertiary_container",
      "light": "tertiary_container"
    },
    "diffRemovedBg": {
      "dark": "error_container",
      "light": "error_container"
    },
    "diffContextBg": {
      "dark": "surface_container_low",
      "light": "surface_container_low"
    },
    "diffLineNumber": {
      "dark": "on_surface_variant",
      "light": "on_surface_variant"
    },
    "diffAddedLineNumberBg": {
      "dark": "tertiary_container",
      "light": "tertiary_container"
    },
    "diffRemovedLineNumberBg": {
      "dark": "error_container",
      "light": "error_container"
    },
    "markdownText": {
      "dark": "on_surface",
      "light": "on_surface"
    },
    "markdownHeading": {
      "dark": "primary",
      "light": "primary"
    },
    "markdownLink": {
      "dark": "primary_fixed_dim",
      "light": "primary_fixed_dim"
    },
    "markdownLinkText": {
      "dark": "primary",
      "light": "primary"
    },
    "markdownCode": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "markdownBlockQuote": {
      "dark": "secondary_container",
      "light": "secondary_container"
    },
    "markdownEmph": {
      "dark": "secondary_fixed",
      "light": "secondary_fixed"
    },
    "markdownStrong": {
      "dark": "primary_fixed",
      "light": "primary_fixed"
    },
    "markdownHorizontalRule": {
      "dark": "outline_variant",
      "light": "outline_variant"
    },
    "markdownListItem": {
      "dark": "secondary",
      "light": "secondary"
    },
    "markdownListEnumeration": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "markdownImage": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "markdownImageText": {
      "dark": "tertiary_fixed",
      "light": "tertiary_fixed"
    },
    "markdownCodeBlock": {
      "dark": "on_surface",
      "light": "on_surface"
    },
    "syntaxComment": {
      "dark": "on_surface_variant",
      "light": "on_surface_variant"
    },
    "syntaxKeyword": {
      "dark": "secondary",
      "light": "secondary"
    },
    "syntaxFunction": {
      "dark": "primary",
      "light": "primary"
    },
    "syntaxVariable": {
      "dark": "on_surface",
      "light": "on_surface"
    },
    "syntaxString": {
      "dark": "tertiary",
      "light": "tertiary"
    },
    "syntaxNumber": {
      "dark": "tertiary_fixed_dim",
      "light": "tertiary_fixed_dim"
    },
    "syntaxType": {
      "dark": "primary_fixed_dim",
      "light": "primary_fixed_dim"
    },
    "syntaxOperator": {
      "dark": "secondary_fixed_dim",
      "light": "secondary_fixed_dim"
    },
    "syntaxPunctuation": {
      "dark": "on_surface_variant",
      "light": "on_surface_variant"
    }
  }
}
